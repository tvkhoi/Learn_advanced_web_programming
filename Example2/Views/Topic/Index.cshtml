    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model IEnumerable<Example2.Models.Topic>
<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Tiêu đề</th>
            <th>Mô tả</th>
            <th>Người tạo</th>
            <th>Ngày tạo</th>
            <th>Hành động</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var topic in Model)
        {
            <tr>
                <td>@topic.Id</td>
                <td>@topic.Title</td>
                <td>@topic.Description</td>
                <td>@(topic.User != null ? topic.User.FullName : "Không xác định")</td>  <!-- Null check added here -->
                <td>@topic.CreatedAt</td>
                <td>
                    <a href="@Url.Action("Edit", new { id = topic.Id })" class="btn btn-primary">Sửa</a>
                    <a href="@Url.Action("Delete", new { id = topic.Id })" class="btn btn-danger">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<a href="@Url.Action("Create")" class="btn btn-success">Thêm mới</a>
