@model Example2.Models.Message
<h2>Thêm mới Tin nhắn</h2>

<form asp-action="Create" method="post">
    <div class="form-group">
        <label for="Content">Nội dung</label>
        <textarea class="form-control" id="Content" name="Content" asp-for="Content" required></textarea>
    </div>
    <div class="form-group">
        <label for="TopicId">Chủ đề</label>
        <select class="form-control" asp-for="TopicId">
            @foreach (var topic in ViewBag.Topics)
            {
                <option value="@topic.Id">@topic.Title</option>
            }
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Gửi</button>
</form>