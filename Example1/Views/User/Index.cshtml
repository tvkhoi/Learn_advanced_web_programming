    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model List<string>

<h1>Danh sách người dùng</h1>

<!-- Hiển thị thông báo thành công -->
@if (TempData["SuccessMessage"] != null)
{
    <p style="color: green;">@TempData["SuccessMessage"]</p>
}

<!-- Hiển thị thông báo lỗi -->
@if (TempData["ErrorMessage"] != null)
{
    <p style="color: red;">@TempData["ErrorMessage"]</p>
}

<ul>
    @foreach (var user in Model)
    {
        <li>
            @user
            <!-- Nút chỉnh sửa -->
            <a href="/User/Edit?UserName=@user" style="color: blue;">Chỉnh sửa</a>
            <!-- Nút xóa -->
            <form method="post" asp-action="Delete" style="display: inline;">
                <input type="hidden" name="userName" value="@user" />
                <button type="submit" style="color: red;">Xóa</button>
            </form>
        </li>
    }
</ul>
